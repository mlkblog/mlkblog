---
/**
 * Mosaico de píldoras del Hero: reinterpreta los trazos redondeados y rellenos
 * de las letras M-L-K. Es el único elemento expresivo del sitio.
 * Cada píldora lleva un color de la paleta: cielo (Educación), azul (identidad),
 * sol (acción), verde (Medio Ambiente) y rojo (Comunidad).
 */
type Fondo = 'cielo' | 'azul' | 'sol' | 'verde' | 'rojo';
type Pildora = { x: number; y: number; w: number; h: number; patron: string; fondo: Fondo };
const pildoras: Pildora[] = [
  { x: 14, y: 170, w: 92, h: 360, patron: 'zigzag', fondo: 'cielo' },
  { x: 118, y: 80, w: 92, h: 450, patron: 'rombos', fondo: 'azul' },
  { x: 222, y: 200, w: 92, h: 330, patron: 'greca', fondo: 'sol' },
  { x: 326, y: 14, w: 92, h: 516, patron: 'lineas', fondo: 'verde' },
  { x: 430, y: 130, w: 92, h: 400, patron: 'espiral', fondo: 'rojo' },
];
const azul = '#273591';
const fondos: Record<Fondo, string> = { cielo: '#addfe9', azul, sol: '#ffcb04', verde: '#136f44', rojo: '#cb1334' };
// Trazo blanco sobre fondos oscuros; azul sobre claros
const sufijo = (f: Fondo) => (f === 'cielo' || f === 'sol' ? 'a' : 'b');
const inset = 15;
---
<svg viewBox="0 0 536 544" class="w-full h-auto" role="img" aria-label="Mosaico de formas redondeadas con los patrones geométricos del logo MLK">
  {pildoras.map((p, i) => (
    <g class="pildora" style={`--i:${i}`}>
      <rect x={p.x} y={p.y} width={p.w} height={p.h} rx={p.w / 2} fill={fondos[p.fondo]} />
      <rect
        x={p.x + inset} y={p.y + inset} width={p.w - inset * 2} height={p.h - inset * 2}
        rx={(p.w - inset * 2) / 2} fill={`url(#p-${p.patron}-${sufijo(p.fondo)})`}
      />
      <rect x={p.x} y={p.y} width={p.w} height={p.h} rx={p.w / 2} fill="none" stroke={azul} stroke-width="9" />
    </g>
  ))}
</svg>
