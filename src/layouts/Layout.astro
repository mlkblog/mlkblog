---
import { ruta } from '../lib/rutas';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Patrones from '../components/Patrones.astro';

// Logo como archivo estático: se descarga una vez y queda en caché para todas las páginas
const logo = { ancho: 64, alto: 63 }; // proporción del viewBox del SVG

interface Props { titulo?: string; descripcion?: string }
const {
  titulo,
  descripcion = 'Blog de los Becarios del Programa Martin Luther King Jr. del Centro Colombo Americano: quiénes somos, nuestras obras sociales y su impacto.',
} = Astro.props;
const tituloCompleto = titulo ? `${titulo} | Becarios MLK` : 'Becarios MLK | Centro Colombo Americano';
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL(ruta('/og.png'), Astro.site); // 1200×630, vista previa al compartir en redes

const enlaces = [
  { href: ruta('/'), texto: 'Inicio' },
  { href: ruta('/nosotros/'), texto: 'Nosotros' },
  { href: ruta('/actividades/'), texto: 'Actividades' },
];
const rutaActual = Astro.url.pathname;
const inicio = ruta('/');
const activo = (href: string) => (href === inicio ? rutaActual === inicio : rutaActual.startsWith(href));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="sitemap" href={ruta("/sitemap-index.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Becarios MLK" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#273591" />
    <link rel="icon" type="image/svg+xml" href={ruta("/favicon.svg")} />
    <Font cssVariable="--font-bricolage" preload={[{ weight: '800' }]} />
    <Font cssVariable="--font-source" preload={[{ weight: '400', style: 'normal' }]} />
    <title>{tituloCompleto}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Patrones />
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-sol focus:px-4 focus:py-2">Saltar al contenido</a>

    <!-- Barra de carga: solo aparece si el cambio de sección tarda más de 120 ms (red lenta) -->
    <div id="barra-carga" class="barra-carga" aria-hidden="true" transition:persist></div>

    <!-- Fijo arriba solo en pantallas anchas y con altura suficiente (en un teléfono horizontal ocuparía demasiado) -->
    <header class="encabezado-vt relative z-40 bg-white sm:sticky sm:top-0 [@media(max-height:500px)]:relative" transition:persist>
      <div class="contenedor flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3">
        <a href={ruta("/")} class="flex min-w-0 items-center gap-3">
          <img src={ruta("/logo-mlk-azul.svg")} alt="" width={logo.ancho} height={logo.alto} class="h-12 w-auto shrink-0 min-[380px]:h-14 sm:h-16" />
          <span class="flex flex-col leading-tight">
            <span class="font-display text-lg font-extrabold text-azul sm:text-xl">Becarios MLK</span>
            <span class="text-sm text-gris">Centro Colombo Americano</span>
          </span>
        </a>
        <nav aria-label="Principal" class="flex w-full items-center justify-between gap-0 sm:w-auto sm:justify-start sm:gap-2">
          {enlaces.map((e) => (
            <a
              href={e.href}
              aria-current={activo(e.href) ? 'page' : undefined}
              data-inicio={e.href === inicio ? '' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center rounded-full px-1.5 text-[0.85rem] font-display font-bold text-tinta min-[380px]:px-2 min-[380px]:text-[0.92rem] sm:px-3 sm:text-base decoration-sol decoration-4 underline-offset-8 transition-colors duration-150 hover:text-azul active:bg-cielo/60 aria-[current=page]:text-azul aria-[current=page]:underline',
                // En pantallas de menos de 360 px el logo ya lleva al inicio: así caben los demás enlaces
                e.href === inicio && 'max-[359px]:hidden',
              ]}
            >{e.texto}</a>
          ))}
          <a href="#contacto" class="btn btn-azul min-h-11 px-3 py-0 text-[0.85rem] min-[380px]:px-4 min-[380px]:text-[0.92rem] sm:ml-1 sm:px-5 sm:text-base">Súmate</a>
        </nav>
      </div>
      <div class="border-b border-linea"></div>
    </header>

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <footer id="contacto" class="cv-auto bg-noche text-white">
      <div class="greca" aria-hidden="true"></div>
      <div class="contenedor grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
        <div class="flex flex-col gap-4">
          <img src={ruta("/logo-mlk-blanco.svg")} alt="Logo del Programa de Becas Martin Luther King Jr." width={logo.ancho * 2} height={logo.alto * 2} loading="lazy" class="mb-2 h-28 w-auto self-start" />
          <h2 class="text-3xl font-extrabold text-white sm:text-4xl">¿Quieres sumarte a la próxima jornada?</h2>
          <p class="max-w-md text-cielo">Buscamos voluntarios, organizaciones aliadas y donaciones en especie. Escríbenos y armamos juntos la siguiente obra social.</p>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-sol">Escríbenos</h3>
          <p>[correo-del-grupo@ejemplo.org]</p>
          <p>Instagram: [@becariosmlk]</p>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-sol">Dónde estamos</h3>
          <p>Centro Colombo Americano<br />[Ciudad, dirección de la sede]</p>
        </div>
      </div>
      <div class="border-t border-white/15">
        <p class="contenedor py-5 text-sm text-white/75">Programa de Becas Martin Luther King Jr. del Centro Colombo Americano.</p>
      </div>
    </footer>

    <script>
      // Navegación interna: marca la página nueva ANTES de mostrarla, para que las animaciones de
      // entrada (mosaico, contadores) solo corran en la primera visita y no en cada cambio de sección
      document.addEventListener('astro:before-swap', (e) => e.newDocument.documentElement.classList.add('navegado'));

      // Barra de carga diferida: si la página llega rápido (precargada) nunca se ve
      let temporizador: number | undefined;
      const barra = () => document.getElementById('barra-carga');
      document.addEventListener('astro:before-preparation', () => {
        clearTimeout(temporizador);
        temporizador = window.setTimeout(() => barra()?.classList.add('activa'), 120);
      });
      document.addEventListener('astro:after-swap', () => {
        clearTimeout(temporizador);
        barra()?.classList.remove('activa');
      });

      // Transición de foto solo entre la tarjeta tocada y su crónica (y al volver, entre la crónica y su tarjeta).
      // Nombrar todas las fotos haría que el navegador capture y anime imágenes que no viajan a ningún lado.
      let fotoQueViaja: string | null = null;
      document.addEventListener('astro:before-preparation', (e) => {
        document.querySelectorAll<HTMLElement>('[data-foto-id]').forEach((el) => (el.style.viewTransitionName = ''));
        // Desde una crónica, la foto principal solo viaja si el destino muestra tarjetas (Inicio o Actividades)
        const inicio = document.querySelector('nav [data-inicio]')?.getAttribute('href') ?? '/';
        const destinoConTarjetas = e.to.pathname === inicio || e.to.pathname.endsWith('/actividades/');
        const origen =
          (e.sourceElement as HTMLElement | undefined)?.querySelector<HTMLElement>('[data-foto-id]') ??
          (destinoConTarjetas ? document.querySelector<HTMLElement>('[data-foto-principal]') : null);
        fotoQueViaja = origen?.dataset.fotoId ?? null;
        if (origen && fotoQueViaja) origen.style.viewTransitionName = `foto-${fotoQueViaja}`;
      });
      document.addEventListener('astro:before-swap', (e) => {
        if (!fotoQueViaja) return;
        const destino = e.newDocument.querySelector<HTMLElement>(`[data-foto-id="${CSS.escape(fotoQueViaja)}"]`);
        if (destino) destino.style.viewTransitionName = `foto-${fotoQueViaja}`;
      });

      // El encabezado persiste entre páginas: actualizamos el enlace activo tras cada navegación
      document.addEventListener('astro:page-load', () => {
        const ruta = location.pathname;
        document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Principal"] a:not(.btn)').forEach((a) => {
          const href = a.getAttribute('href')!;
          const activo = a.hasAttribute('data-inicio') ? ruta === href : ruta.startsWith(href);
          if (activo) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      });
    </script>
  </body>
</html>
