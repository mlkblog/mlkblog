---
import { ruta } from '../lib/rutas';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Mosaico from '../components/Mosaico.astro';
import Contador from '../components/Contador.astro';
import TarjetaActividad from '../components/TarjetaActividad.astro';
import { enlaceCorreo } from '../lib/contacto';
import { esObraSocial } from '../content.config';

const actividades = (await getCollection('actividades')).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
const recientes = actividades.slice(0, 3);
// Las cifras de impacto solo cuentan obras sociales (no las crónicas de «Nuestro grupo»)
const obras = actividades.filter((a) => esObraSocial(a.data.categoria));
const personas = obras.reduce((s, a) => s + a.data.beneficiarios, 0);
const horas = obras.reduce((s, a) => s + a.data.horasVoluntariado, 0);
const hayEjemplos = obras.some((a) => a.data.ejemplo);

// Formas de sumarse: cada una con su color de la paleta (tinte de fondo + píldora del tono pleno)
const formas = [
  { titulo: 'Voluntariado', texto: 'Acompáñanos en la próxima jornada: siembras, clubes de lectura, brigadas en el barrio. Solo hacen falta ganas y una mañana libre.', accion: 'Quiero ser voluntario', asunto: 'Quiero ser voluntario', fondo: 'bg-crema', pildora: 'bg-sol' },
  { titulo: 'Alianzas', texto: 'Si tu fundación, colegio o empresa trabaja con comunidades, diseñemos juntos una obra social con impacto medible.', accion: 'Proponer una alianza', asunto: 'Propuesta de alianza', fondo: 'bg-agua', pildora: 'bg-mar' },
  { titulo: 'Donaciones en especie', texto: 'Libros, plántulas, herramientas o refrigerios para los voluntarios. Te contamos en qué jornada se usó cada aporte.', accion: 'Ofrecer una donación', asunto: 'Donación en especie', fondo: 'bg-rosa', pildora: 'bg-rojo' },
];
---
<Layout>
  <!-- Hero -->
  <section class="contenedor grid items-center gap-10 pb-16 pt-10 md:grid-cols-[1.15fr_1fr] md:pb-24 md:pt-16">
    <div class="flex flex-col gap-7">
      <p class="self-start rounded-full bg-crema px-4 py-1.5 font-display font-bold text-ambar">Programa de Becas Martin Luther King Jr., Barranquilla</p>
      <h1 class="text-5xl font-extrabold sm:text-6xl lg:text-7xl">Servir también es una forma de liderar.</h1>
      <p class="prosa text-xl text-gris">
        Somos jóvenes becarios del Centro Colombo Americano. Inspirados en el legado de Martin Luther King Jr., organizamos obras sociales con comunidades y aquí contamos qué hicimos, con quién y qué cambió.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={ruta("/actividades/")} class="btn btn-azul">Leer las crónicas</a>
        <a href={ruta("/nosotros/")} class="btn btn-borde">Conocer al equipo</a>
      </div>
    </div>
    <div class="mx-auto w-full max-w-[17rem] sm:max-w-sm md:max-w-none">
      <Mosaico />
    </div>
  </section>

  <!-- Cifras de impacto -->
  <section class="bg-azul" aria-labelledby="titulo-impacto">
    <div class:list={['contenedor grid gap-10 py-14 md:grid-cols-[1fr_2.4fr]', obras.length > 0 ? 'md:items-end' : 'md:items-center']}>
      <div class="flex flex-col gap-3">
        <h2 id="titulo-impacto" class="text-3xl font-extrabold text-white">Nuestro impacto hasta hoy</h2>
        {obras.length > 0 && <p class="text-cielo">Cifras sumadas automáticamente a partir de las crónicas publicadas.{hayEjemplos && ' Hoy incluyen crónicas de ejemplo.'}</p>}
      </div>
      {obras.length > 0 ? (
        <div class="grid gap-8 sm:grid-cols-3">
          <Contador valor={obras.length} etiqueta={obras.length === 1 ? 'obra social' : 'obras sociales'} acento="bg-sol" />
          <Contador valor={personas} etiqueta="personas acompañadas" acento="bg-cielo" />
          <Contador valor={horas} etiqueta="horas de voluntariado" acento="bg-menta" />
        </div>
      ) : (
        <div class="flex flex-col gap-3">
          <span class="block h-2 w-12 rounded-full bg-sol" aria-hidden="true"></span>
          <p class="font-display text-3xl font-extrabold text-white sm:text-4xl">Nuestra primera obra social está en camino.</p>
          <p class="max-w-prose text-lg text-cielo">Cuando la publiquemos, aquí verás cuántas personas acompañamos y cuántas horas de voluntariado sumamos.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Recientes -->
  <section class="contenedor flex flex-col gap-10 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-4xl font-extrabold sm:text-5xl">Crónicas recientes</h2>
      <a href={ruta("/actividades/")} class="inline-flex min-h-11 items-center font-display font-bold text-azul underline decoration-sol decoration-4 underline-offset-8">Ver todas</a>
    </div>
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-3">
      {recientes.map((a, i) => <TarjetaActividad actividad={a} destacada={i === 0} />)}
    </div>
  </section>

  <!-- Cómo sumarse -->
  <section class="cv-auto border-t border-linea" aria-labelledby="titulo-sumarte">
    <div class="contenedor flex flex-col gap-10 py-20">
      <div class="flex flex-col gap-3">
        <h2 id="titulo-sumarte" class="text-4xl font-extrabold sm:text-5xl">Súmate a la próxima obra</h2>
        <p class="prosa text-gris">Cada jornada sale adelante gracias a personas y organizaciones de Barranquilla. Hay tres maneras de aportar.</p>
      </div>
      <ul class="grid gap-5 md:grid-cols-3">
        {formas.map((f) => (
          <li class:list={['flex flex-col gap-4 rounded-foto p-7', f.fondo]}>
            <span class:list={['block h-2 w-12 rounded-full', f.pildora]} aria-hidden="true"></span>
            <h3 class="text-2xl font-extrabold">{f.titulo}</h3>
            <p class="flex-1 text-tinta">{f.texto}</p>
            <a href={enlaceCorreo(f.asunto)} class="inline-flex min-h-11 items-center self-start font-display font-bold text-azul underline decoration-2 underline-offset-4 hover:decoration-sol">{f.accion}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Cita -->
  <section class="cv-auto bg-cielo">
    <figure class="contenedor flex flex-col gap-6 py-20">
      <span class="-mb-10 font-display text-[7rem] font-extrabold leading-none text-rojo sm:-mb-14 sm:text-[10rem]" aria-hidden="true">“</span>
      <blockquote class="max-w-4xl font-display text-3xl font-extrabold leading-tight text-azul sm:text-5xl">
        La pregunta más persistente y urgente de la vida es: ¿qué estás haciendo por los demás?
      </blockquote>
      <figcaption class="text-lg font-semibold text-mar">Martin Luther King Jr., Montgomery, 1957</figcaption>
    </figure>
  </section>
</Layout>
