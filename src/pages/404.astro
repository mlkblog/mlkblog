---
import { ruta } from '../lib/rutas';
import Layout from '../layouts/Layout.astro';
---
<Layout titulo="Página no encontrada" descripcion="La página que buscas no existe o cambió de dirección.">
  <section class="contenedor flex flex-col items-start gap-6 py-24">
    <p class="font-display text-8xl font-extrabold text-rojo">404</p>
    <h1 class="text-4xl font-extrabold sm:text-5xl">No encontramos esta página</h1>
    <p class="prosa text-xl text-gris">Puede que la dirección esté mal escrita o que la crónica haya cambiado de nombre. Desde aquí puedes volver al inicio o ver todas las obras sociales.</p>
    <div class="flex flex-wrap gap-3">
      <a href={ruta("/")} class="btn btn-azul">Ir al inicio</a>
      <a href={ruta("/actividades/")} class="btn btn-borde">Ver las crónicas</a>
    </div>
  </section>
</Layout>
